{
  "19": [
    {
      "platform": "虎扑",
      "date": "10.24",
      "text": "瓦塞尔：墨西哥站挑战将截然不同，高海拔让一切变得不确定。",
      "url": "https://bbs.hupu.com/635338812.html"
    },
    {
      "platform": "虎扑",
      "date": "10.27",
      "text": "诺里斯：墨西哥站杆位夺冠，正是我想要的胜利。",
      "url": "https://bbs.hupu.com/635400206.html"
    },
    {
      "platform": "虎扑",
      "date": "10.28",
      "text": "马尔科对维斯塔潘的墨西哥站表现惊叹：这就是马克斯。",
      "url": "https://bbs.hupu.com/635420041.html"
    }
  ],
  "20": [
    {
      "platform": "虎扑",
      "date": "11.07",
      "text": "维斯塔潘对雨战保持谨慎：风险很大，但我不会感到压力。",
      "url": "https://bbs.hupu.com/635606846.html"
    },
    {
      "platform": "虎扑",
      "date": "11.07",
      "text": "阿隆索：巴西对我有特殊情感，英特拉格斯总能带来不一样的比赛。",
      "url": "https://bbs.hupu.com/635616491.html"
    },
    {
      "platform": "B站",
      "date": "11.06",
      "text": "圣保罗的雨夜总能改写比赛，2024 年维斯塔潘从第 17 位发车夺冠就是例子。",
      "url": "https://www.bilibili.com/video/BV1XCDuBkE2g/"
    }
  ],
  "21": [
    {
      "platform": "虎扑",
      "date": "11.20",
      "text": "拉塞尔担心拉斯维加斯的低温会让梅赛德斯失去优势。",
      "url": "https://bbs.hupu.com/635841867.html"
    },
    {
      "platform": "虎扑",
      "date": "11.21",
      "text": "角田更换动力单元从维修区起步，红牛的安排又被吐槽了。",
      "url": "https://bbs.hupu.com/635902358.html"
    },
    {
      "platform": "虎扑",
      "date": "11.22",
      "text": "汉密尔顿在拉斯维加斯的表现又引发讨论，超车和失误都被放大。",
      "url": "https://bbs.hupu.com/635905703.html"
    }
  ],
  "22": [
    {
      "platform": "虎扑",
      "date": "11.30",
      "text": "维斯塔潘夺冠，迈凯伦的安全车决策又被拿出来讨论。",
      "url": "https://bbs.hupu.com/636044524.html"
    },
    {
      "platform": "虎扑",
      "date": "11.30",
      "text": "皮亚斯特里冲线后在 TR 里只说：无言以对。",
      "url": "https://bbs.hupu.com/636046761.html"
    },
    {
      "platform": "虎扑",
      "date": "11.30",
      "text": "很久没在收官战看到多车手争冠了，今年终于又等到了。",
      "url": "https://bbs.hupu.com/636046841.html"
    }
  ],
  "23": [
    {
      "platform": "虎扑",
      "date": "12.09",
      "text": "角田代表红牛最后一战，和维斯塔潘互相交换头盔。",
      "url": "https://bbs.hupu.com/636234343.html"
    },
    {
      "platform": "虎扑",
      "date": "12.08",
      "text": "诺里斯加冕年度冠军，红牛也发文祝贺。",
      "url": "https://bbs.hupu.com/636206579.html"
    },
    {
      "platform": "虎扑",
      "date": "12.09",
      "text": "维斯塔潘：对这个赛季没有遗憾，现在的感受甚至好过去年。",
      "url": "https://bbs.hupu.com/636223652.html"
    }
  ]
